load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "state",
    compile_data = glob([
        "accounting_migrations/**",
        "goals_migrations/**",
        "logs_migrations/**",
        "memory_migrations/**",
        "migrations/**",
        "thread_history_migrations/**",
    ]),
    crate_name = "codex_state",
    # Several integration tests share this helper through `#[path]`.
    integration_compile_data_extra = ["src/runtime/accounting_late_import_test_support.rs"],
    # Several unit tests bound how long a request waits on the state DB, and
    # use more than the one core Bazel reserves per test by default: libtest
    # runs one test per core unless RUST_TEST_THREADS says otherwise, and
    # `ten_sessions_on_one_home_wait_briefly_and_lose_no_record` runs ten
    # sessions on a 4-worker runtime. With compiles beside it on the 4-core
    # Windows runner, that test went past its bound (#905). Reserve 4 cores.
    unit_test_tags = ["cpu:4"],
    # Two of those bounds still failed with the four cores reserved, because
    # libtest ran three other state tests beside them (#905, #1881). These
    # run in `state-unit-tests-alone`, one at a time, and are skipped here.
    # Their cores are still reserved (`cpu:4`), so no compile runs beside them.
    unit_test_alone = [
        "runtime::accounting::store::tests::expiry_at_the_detail_horizon_never_holds_up_another_writer",
        "runtime::accounting::store::writer::tests::ten_sessions_on_one_home_wait_briefly_and_lose_no_record",
    ],
    # The accounting suites take ~210s on a 4-core Windows runner on their
    # own, so the default 300s budget times out when Bazel runs tests in parallel.
    unit_test_timeout = "long",
)
